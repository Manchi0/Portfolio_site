# .gitignore for portfolio site
# Ignored by user request: markdown files and any "claude" files
# By default ignore Markdown files, but keep README and other important root docs tracked
*.md
!LICENSE.md

# Claude / assistant artifacts
*claude*
claude-*
claude.*
claude/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
out/
public/build/
.parcel-cache/
.cache/
.vite/

# Env files
.env
.env.*
.env.local

# Logs
logs/
*.log

# Coverage
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Temporary / swap
*.tmp
*.temp
*.bak
*.swp
*.swo

# OneDrive / Office temp files
~$*

# Windows recycle bin
$RECYCLE.BIN/
